<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>Valorant Store</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&family=Bebas+Neue&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/store.css"/>
</head>
<body>

<!-- ============================================ -->
<!-- NAVBAR (identical to original)               -->
<!-- ============================================ -->
<header class="navbar">
  <div class="logo-section">
    <a href="/"><img src="/images/RIOT_LOGO.png" alt="Riot Games Logo" class="riot-logo"/></a>
    <a href="/"><img src="/images/VALORANT_ICON.png" alt="Valorant Icon" class="valo-icon"/></a>
  </div>

  <nav class="nav-menu">
    <ul>
      <li class="dropdown">
        <a href="#" class="dropbtn">GAME INFO</a>
        <ul class="dropdown-content">
          <li><a href="/agents">Agents</a></li>
          <li><a href="/maps">Maps</a></li>
          <li><a href="#">Arsenal</a></li>
          <li><a href="#">Premier</a></li>
          <li><a href="/random-agents" target="_blank">Random Agent Generator</a></li>
          <li><a href="/guns-random-skin" target="_blank">Random Gun Skin Generator</a></li>
          <li><a href="/maps-random" target="_blank">Random Map Generator</a></li>
          <li><a href="/agents-oop" target="_blank">VIEW AGENTS (OOP DEMO)</a></li>
        </ul>
      </li>
      <li><a href="https://playvalorant.com/en-us/media">MEDIA</a></li>
      <li><a href="https://playvalorant.com/en-us/news/">NEWS</a></li>
      <li class="dropdown">
        <a href="https://support-valorant.riotgames.com/hc/en-us/" class="dropbtn">SUPPORT</a>
        <ul class="dropdown-content">
          <li><a href="https://playvalorant.com/en-us/specs/">Specs</a></li>
          <li><a href="https://support-valorant.riotgames.com/hc/en-us/">Support</a></li>
          <li><a href="https://playvalorant.com/en-us/news/announcements/valorant-community-code/">Community</a></li>
          <li><a href="#">Code</a></li>
        </ul>
      </li>
      <li><a href="https://valorantesports.com/">ESPORTS</a></li>
      <li><a href="https://ftw.riotgames.com/valorant/champions-of-champions">CHAMPIONS OF CHAMPIONS</a></li>
      <li><a href="/store">STORE</a></li>
    </ul>
  </nav>

  <div class="menu-section">
    <% if (currentUser) { %>
      <a href="/dashboard" style="color:white; font-weight:bold; margin-right:10px; text-decoration:none;">
        <%= currentUser.username.toUpperCase() %>
      </a>
      <a href="/logout" style="color:#ff4655; font-weight:bold; text-decoration:none;">LOGOUT</a>
    <% } else { %>
      <a href="/login" style="color:white; font-weight:bold; margin-right:10px; text-decoration:none;">LOGIN</a>
    <% } %>
    <a href="/" class="playnow-link">
      <img src="/images/home_ICON.png" alt="Home" class="nav-icon search-icon"/>
    </a>
    <img src="/images/BROWSER_LOGO.png" alt="Browse" class="nav-icon browser-icon big"/>
    <img src="/images/HAMBURGER_ICON.png" alt="Menu" class="nav-icon hamburger-icon big"/>
  </div>
</header>

<!-- ============================================ -->
<!-- STORE MAIN                                   -->
<!-- ============================================ -->
<main class="store-main">

  <!-- Search and Filters (identical to original) -->
  <section class="store-filters">
    <input type="text" class="store-search" id="storeSearch" placeholder="Search a skin"/>

    <div class="store-chips" id="chip-row-1">
      <button class="chip selected" data-weapon="Classic">Classic</button>
      <button class="chip" data-weapon="Shorty">Shorty</button>
      <button class="chip" data-weapon="Frenzy">Frenzy</button>
      <button class="chip" data-weapon="Ghost">Ghost</button>
      <button class="chip" data-weapon="Sheriff">Sheriff</button>
      <button class="chip" data-weapon="Stinger">Stinger</button>
      <button class="chip" data-weapon="Spectre">Spectre</button>
      <button class="chip" data-weapon="Bucky">Bucky</button>
      <button class="chip" data-weapon="Judge">Judge</button>
    </div>

    <div class="store-chips" id="chip-row-2">
      <div class="chip-group-label">Weapons</div>
      <button class="chip" data-weapon="Bulldog">Bulldog</button>
      <button class="chip" data-weapon="Guardian">Guardian</button>
      <button class="chip" data-weapon="Phantom">Phantom</button>
      <button class="chip" data-weapon="Vandal">Vandal</button>
      <button class="chip" data-weapon="Marshal">Marshal</button>
      <button class="chip" data-weapon="Outlaw">Outlaw</button>
      <button class="chip" data-weapon="Operator">Operator</button>
      <button class="chip" data-weapon="Ares">Ares</button>
      <button class="chip" data-weapon="Odin">Odin</button>
      <button class="chip" data-weapon="Melee">Melee</button>
    </div>

    <div class="store-chips" id="chip-row-3">
      <div class="chip-group-label">Price tier</div>
      <button class="chip chip-tier selected" data-tier="All">All</button>
      <button class="chip chip-tier" data-tier="Select">Select Edition</button>
      <button class="chip chip-tier" data-tier="Deluxe">Deluxe Edition</button>
      <button class="chip chip-tier" data-tier="Premium">Premium Edition</button>
      <button class="chip chip-tier" data-tier="Exclusive">Exclusive Edition</button>
      <button class="chip chip-tier" data-tier="Ultra">Ultra Edition</button>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- WEAPON GRID — DYNAMIC FROM MySQL             -->
  <!-- ============================================ -->
  <section class="store-grid" id="skinGrid">

    <% skins.forEach(skin => { %>

      <%
        /* Map tier name → CSS class (matches original store.css) */
        const tierClassMap = {
          'Select':    'skin-tier-select',
          'Deluxe':    'skin-tier-deluxe',
          'Premium':   'skin-tier-premium',
          'Exclusive': 'skin-tier-exclusive',
          'Ultra':     'skin-tier-ultra'
        };
        const tierClass = tierClassMap[skin.tier] || '';
      %>

      <div class="store-grid-card"
           data-skin-id="<%= skin.id %>"
           data-video="<%= skin.video || '' %>"
           data-img="<%= skin.image %>"
           data-name="<%= skin.name %>"
           data-price="<%= skin.price.toLocaleString() %>"
           data-tier="<%= skin.tier %>"
           data-weapon="<%= skin.weapon_type %>"
           onclick="openModal(this)">

        <img src="<%= skin.image %>"
             alt="<%= skin.name %>"
             class="skin-img"
             onerror="this.src='/images/VALORANT_ICON.png'"/>

        <div class="skin-details">
          <span class="skin-tier <%= tierClass %>"><%= skin.tier %></span>
          <span class="skin-name"><%= skin.name %></span>
          <span class="skin-price"><%= skin.price.toLocaleString() %></span>

          <!-- Buy button: posts to /purchase if logged in, else redirect to login -->
          <% if (currentUser) { %>
            <form action="/purchase" method="POST" onclick="event.stopPropagation()">
              <input type="hidden" name="skin_id" value="<%= skin.id %>"/>
              <button type="submit" class="buy-button">Buy</button>
            </form>
          <% } else { %>
            <a href="/login" class="buy-button" onclick="event.stopPropagation()">Buy</a>
          <% } %>

        </div>
      </div>

    <% }) %>

  </section>

  <!-- Empty state (shown via JS if filters return nothing) -->
  <div class="store-empty" id="storeEmpty" style="display:none;">
    <p>No skins found. Try a different filter.</p>
  </div>

</main>

<!-- ============================================ -->
<!-- MODAL POPUP (identical structure to original)-->
<!-- ============================================ -->
<div class="store-modal" id="storeModal" style="display:none;">
  <div class="store-modal-backdrop" onclick="closeModal()"></div>
  <div class="store-modal-box">
    <span class="modal-close" onclick="closeModal()">&times;</span>

    <video class="modal-video" id="modalVideo" src="" controls autoplay></video>

    <div class="modal-varients">
      <button class="variant-btn active">I</button>
      <button class="variant-btn">II</button>
      <button class="variant-btn">III</button>
      <button class="variant-btn">IV</button>
    </div>

    <div class="modal-skin-details">
      <img src="" alt="Skin Preview" class="modal-img" id="modalImg"/>
      <div class="modal-skin-name"  id="modalSkinName"></div>
      <span class="skin-tier skin-tier-exclusive" id="modalTier"></span>
      <span class="modal-skin-price" id="modalSkinPrice"></span>
      <span class="modal-usercount">&#128100; 34,339</span>

      <!-- MODAL BUY FORM -->
      <div id="modalBuyArea" style="margin-top:14px;"></div>
    </div>
  </div>
</div>

<!-- ============================================ -->
<!-- FOOTER (identical to original)               -->
<!-- ============================================ -->
<footer class="riot-footer">
  <div class="footer-social">
    <a href="https://twitter.com/valorant"          target="_blank" class="footer-icon"><img src="/images/X_LOGO.png"         alt="X"/></a>
    <a href="https://www.youtube.com/@valorant"     target="_blank" class="footer-icon"><img src="/images/YT_LOGO.png"        alt="YouTube"/></a>
    <a href="https://instagram.com/valorant"        target="_blank" class="footer-icon"><img src="/images/INSTAGRAM_LOGO.png" alt="Instagram"/></a>
    <a href="https://www.tiktok.com/@valorant"      target="_blank" class="footer-icon"><img src="/images/TIK TOK_LOGO.png"   alt="TikTok"/></a>
    <a href="https://www.facebook.com/playvalorant/" target="_blank" class="footer-icon"><img src="/images/FACEBOOK_LOGO.png" alt="Facebook"/></a>
    <a href="https://discord.gg/valorant"           target="_blank" class="footer-icon"><img src="/images/DISCORD_LOGO.png"   alt="Discord"/></a>
  </div>
  <img src="/images/RIOT_GAMES_LOGO.png" alt="Riot Games" class="footer-riot-logo"/>
  <div class="footer-copyright">
    © 2020-2026 Riot Games, Inc. RIOT GAMES, VALORANT and any associated logos are trademarks of Riot Games, Inc.
  </div>
  <div class="footer-links">
    <a href="https://www.riotgames.com/en/privacy-notice" class="footer-link">PRIVACY NOTICE</a>
    <a href="https://www.riotgames.com/en/terms-of-service" class="footer-link">TERMS OF SERVICE</a>
    <a href="#" class="footer-link">COOKIE PREFERENCES</a>
  </div>
  <div class="footer-esrb">
    <img src="/images/UA_LOGO.png" alt="ESRB Rating" class="footer-esrb-img"/>
    <div class="footer-esrb-text">
      Blood<br>Language<br>Violence<br>Users Interact<br>In-Game Purchases
    </div>
  </div>
</footer>

<!-- ============================================ -->
<!-- JAVASCRIPT                                   -->
<!-- ============================================ -->
<script>

  // ── MODAL ──────────────────────────────────────
  function openModal(card) {
    const modal = document.getElementById('storeModal');
    modal.style.display = 'flex';

    // Populate video + image
    const videoEl = document.getElementById('modalVideo');
    const videoSrc = card.dataset.video;
    if (videoSrc) {
      videoEl.src = videoSrc;
      videoEl.style.display = 'block';
    } else {
      videoEl.src = '';
      videoEl.style.display = 'none';
    }

    document.getElementById('modalImg').src          = card.dataset.img;
    document.getElementById('modalSkinName').innerText = card.dataset.name;
    document.getElementById('modalSkinPrice').innerText = card.dataset.price + ' VP';
    document.getElementById('modalTier').innerText   = card.dataset.tier;

    // Inject buy form into modal (or login link)
    const buyArea  = document.getElementById('modalBuyArea');
    const skinId   = card.dataset.skinId;
    const loggedIn = '<%= currentUser ? "yes" : "no" %>';

    if (loggedIn === 'yes') {
      buyArea.innerHTML = `
        <form action="/purchase" method="POST">
          <input type="hidden" name="skin_id" value="${skinId}"/>
          <button type="submit" class="buy-button" style="width:100%;padding:12px;font-size:15px;">
            BUY NOW
          </button>
        </form>`;
    } else {
      buyArea.innerHTML = `
        <a href="/login" class="buy-button"
           style="display:block;text-align:center;padding:12px;font-size:15px;text-decoration:none;">
          LOGIN TO BUY
        </a>`;
    }
  }

  function closeModal() {
    document.getElementById('storeModal').style.display = 'none';
    document.getElementById('modalVideo').pause();
    document.getElementById('modalVideo').src = '';
  }

  // ── SEARCH FILTER ──────────────────────────────
  document.getElementById('storeSearch').addEventListener('input', function () {
    filterCards();
  });

  // ── WEAPON CHIP FILTER ─────────────────────────
  let activeWeapon = '';
  let activeTier   = 'All';

  document.querySelectorAll('.chip:not(.chip-tier)').forEach(btn => {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.chip:not(.chip-tier)').forEach(b => b.classList.remove('selected'));
      this.classList.add('selected');
      activeWeapon = this.dataset.weapon === activeWeapon ? '' : this.dataset.weapon;
      filterCards();
    });
  });

  // ── TIER CHIP FILTER ───────────────────────────
  document.querySelectorAll('.chip-tier').forEach(btn => {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.chip-tier').forEach(b => b.classList.remove('selected'));
      this.classList.add('selected');
      activeTier = this.dataset.tier;
      filterCards();
    });
  });

  // ── COMBINED FILTER FUNCTION ───────────────────
  function filterCards() {
    const query  = document.getElementById('storeSearch').value.toLowerCase();
    const cards  = document.querySelectorAll('.store-grid-card');
    let   visible = 0;

    cards.forEach(card => {
      const name   = card.dataset.name.toLowerCase();
      const weapon = card.dataset.weapon;
      const tier   = card.dataset.tier;

      const matchSearch = name.includes(query);
      const matchWeapon = !activeWeapon || weapon === activeWeapon;
      const matchTier   = activeTier === 'All' || tier === activeTier;

      if (matchSearch && matchWeapon && matchTier) {
        card.style.display = '';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    document.getElementById('storeEmpty').style.display = visible === 0 ? 'block' : 'none';
  }

</script>

</body>
</html>