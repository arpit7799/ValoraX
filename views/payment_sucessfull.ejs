<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Purchase Successful • VALORANT</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Roboto:wght@300;400;700&display=swap" rel="stylesheet"/>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #0f1923;
      color: white;
      font-family: 'Roboto', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* NAVBAR */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 40px;
      background: #111;
      border-bottom: 2px solid #ff4655;
    }
    .navbar a {
      color: white;
      text-decoration: none;
      font-weight: bold;
      margin-left: 20px;
      font-size: 13px;
      letter-spacing: 1px;
    }
    .navbar a:hover { color: #ff4655; }
    .navbar-brand {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 24px;
      letter-spacing: 2px;
      color: #ff4655;
    }

    /* MAIN */
    .success-container {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 20px;
    }

    .success-box {
      background: #1f2731;
      border: 1px solid #2e3a47;
      border-radius: 16px;
      padding: 50px 40px;
      max-width: 560px;
      width: 100%;
      text-align: center;
    }

    /* CHECKMARK ANIMATION */
    .success-icon {
      width: 80px;
      height: 80px;
      background: rgba(34, 197, 94, 0.15);
      border: 2px solid #22c55e;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 24px;
      font-size: 36px;
      animation: popIn 0.4s ease;
    }

    @keyframes popIn {
      0%   { transform: scale(0); opacity: 0; }
      70%  { transform: scale(1.1); }
      100% { transform: scale(1); opacity: 1; }
    }

    .success-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 42px;
      letter-spacing: 3px;
      color: #22c55e;
      margin-bottom: 8px;
    }

    .success-subtitle {
      color: #888;
      font-size: 14px;
      margin-bottom: 32px;
      line-height: 1.6;
    }

    /* SKIN PREVIEW CARD */
    .skin-preview {
      background: #0f1923;
      border: 1px solid #2e3a47;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 28px;
      display: flex;
      align-items: center;
      gap: 20px;
      text-align: left;
    }

    .skin-preview img {
      width: 110px;
      height: 70px;
      object-fit: contain;
      flex-shrink: 0;
      border-radius: 6px;
      background: #1a2330;
      padding: 6px;
    }

    .skin-preview-info { flex: 1; }

    .skin-preview-name {
      font-weight: bold;
      font-size: 18px;
      color: white;
      margin-bottom: 6px;
    }

    .skin-preview-meta {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .badge {
      font-size: 11px;
      padding: 3px 10px;
      border-radius: 20px;
      font-weight: bold;
    }
    .badge-weapon { background: #1a2940; color: #7eb3e0; border: 1px solid #2e4a6a; }
    .badge-tier   { background: #2a1a1f; color: #ff8a95; border: 1px solid #5a2a30; }
    .badge-price  { background: #1a2a1a; color: #7ecf7e; border: 1px solid #2a5a2a; }

    /* ORDER INFO */
    .order-info {
      background: #0f1923;
      border: 1px solid #2e3a47;
      border-radius: 10px;
      padding: 16px 20px;
      margin-bottom: 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .order-info-item { text-align: center; }

    .order-info-label {
      font-size: 11px;
      color: #555;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 4px;
    }

    .order-info-value {
      font-size: 15px;
      font-weight: bold;
      color: white;
    }

    .order-info-value.green { color: #22c55e; }

    /* ACTIONS */
    .action-buttons {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn-store {
      flex: 1;
      padding: 13px;
      background: #ff4655;
      border: none;
      border-radius: 8px;
      color: white;
      font-weight: bold;
      font-size: 14px;
      letter-spacing: 1px;
      text-decoration: none;
      text-align: center;
      cursor: pointer;
      transition: background 0.2s;
    }
    .btn-store:hover { background: #e03c4c; }

    .btn-dashboard {
      flex: 1;
      padding: 13px;
      background: transparent;
      border: 1px solid #2e3a47;
      border-radius: 8px;
      color: #aaa;
      font-weight: bold;
      font-size: 14px;
      letter-spacing: 1px;
      text-decoration: none;
      text-align: center;
      transition: border-color 0.2s, color 0.2s;
    }
    .btn-dashboard:hover { border-color: #ff4655; color: white; }

    /* FOOTER */
    footer {
      padding: 20px;
      text-align: center;
      background: #111;
      border-top: 1px solid #2e3a47;
      color: #555;
      font-size: 13px;
    }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <div class="navbar">
    <span class="navbar-brand">VALORANT</span>
    <div>
      <a href="/">HOME</a>
      <a href="/store">STORE</a>
      <a href="/dashboard">MY ACCOUNT</a>
      <a href="/logout" style="color:#ff4655;">LOGOUT</a>
    </div>
  </div>

  <!-- SUCCESS MAIN -->
  <div class="success-container">
    <div class="success-box">

      <!-- ANIMATED CHECKMARK -->
      <div class="success-icon">✓</div>

      <div class="success-title">PURCHASE SUCCESSFUL!</div>
      <div class="success-subtitle">
        Your skin has been added to your account.<br>
        Check your order history in the dashboard.
      </div>

      <!-- SKIN PREVIEW -->
      <div class="skin-preview">
        <img src="<%= skin.image %>"
             alt="<%= skin.name %>"
             onerror="this.src='/images/VALORANT_ICON.png'"/>
        <div class="skin-preview-info">
          <div class="skin-preview-name"><%= skin.name %></div>
          <div class="skin-preview-meta">
            <span class="badge badge-weapon"><%= skin.weapon_type %></span>
            <span class="badge badge-tier"><%= skin.tier %></span>
            <span class="badge badge-price"><%= skin.price.toLocaleString() %> VP</span>
          </div>
        </div>
      </div>

      <!-- ORDER SUMMARY -->
      <div class="order-info">
        <div class="order-info-item">
          <div class="order-info-label">Order ID</div>
          <div class="order-info-value">#<%= order_id %></div>
        </div>
        <div class="order-info-item">
          <div class="order-info-label">Amount Paid</div>
          <div class="order-info-value green">
            <%= skin.price.toLocaleString() %> VP
          </div>
        </div>
        <div class="order-info-item">
          <div class="order-info-label">Status</div>
          <div class="order-info-value green">CONFIRMED ✓</div>
        </div>
        <div class="order-info-item">
          <div class="order-info-label">Buyer</div>
          <div class="order-info-value">
            <%= currentUser ? currentUser.username : 'Guest' %>
          </div>
        </div>
      </div>

      <!-- ACTION BUTTONS -->
      <div class="action-buttons">
        <a href="/store" class="btn-store">← BACK TO STORE</a>
        <a href="/dashboard" class="btn-dashboard">VIEW ORDER HISTORY</a>
      </div>

    </div>
  </div>

  <!-- FOOTER -->
  <footer>
    © 2020-2026 Riot Games, Inc. VALORANT and associated logos are trademarks of Riot Games, Inc.
  </footer>

</body>
</html>